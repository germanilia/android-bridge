<?xml version="1.0" encoding="UTF-8"?>
<!--
  Relay logging. Console keeps `docker logs` working; the rolling file keeps a durable
  copy on the relay host. Files roll daily and are retained for 4 days (maxHistory),
  with a total size cap so a flapping peer cannot fill the disk.
-->
<configuration>
    <property name="LOG_DIR" value="${RELAY_LOG_DIR:-/logs}"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level %logger -- %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/relay.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/relay.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>4</maxHistory>
            <totalSizeCap>512MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
